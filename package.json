{
  "name": "dsh-plugin-auth-gate",
  "description": "Login gate, TOTP MFA, signed sessions, and workspace-scoped account isolation for the DeepSeek Harness Web GUI",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./webserver": {
      "types": "./lib/types/webserver.d.ts",
      "default": "./lib/webserver.js"
    },
    "./gate": {
      "types": "./lib/types/gate.d.ts",
      "default": "./lib/gate.js"
    },
    "./package.json": "./package.json",
    "./admin-page": {
      "default": "./lib/admin-page.js"
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
